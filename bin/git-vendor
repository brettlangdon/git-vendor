#!/bin/sh
#
# git-vendor.sh: manage vendored repos via git-subtree
#
# Copyright (c) 2016 Brett Langdon <me@brett.is>
#
_usage()
{
    cat <<EOF
Usage:
  git vendor --help
  git vendor add [--prefix <dir>] <name> <repository> [<ref>]
  git vendor list [<name>]
  git vendor remove <name>
  git vendor update <name> [<ref>]
  git vendor upstream <name> [<ref>] [--repo <repository>]
EOF
}

case "$1" in
    ""|"-h"|"--help") _usage && exit ;;
esac

PATH=$PATH:$(git --exec-path)
. git-sh-setup
require_work_tree

command="$1"
shift
case "$command" in
    "add"|"list"|"remove"|"update"|"upstream") ;;
    *) >&2 echo "error: unknown command \"$command\"" && _usage && exit 1 ;;
esac

prefix="vendor"
if [ "$1" = "--prefix" ]; then
    prefix="$2"
    shift; shift
fi

# Vendored dependencies are recorded in commit messages, newest first. A
# removed tree has no directory, and a re-added tree uses its newest name.
vendor_names_from_log()
{
    name=
    dir=
    git log --grep="^git-vendor-name: .*\$" \
	--pretty=format:'START %H%n%s%n%n%b%nEND%n' HEAD |
	while read -r a b junk; do
	    case "$a" in
		START) ;;
		git-vendor-name:) name="$b" ;;
                git-vendor-dir:) dir="$b" ;;
		END)
                    # Keep the directory as the key, rather than replacing
                    # punctuation: foo-bar and foo_bar are different trees.
                    # Commits arrive newest first, so awk keeps the current
                    # name if a tree was removed and added again.
                    if [ -d "$dir" ]; then
                        printf '%s\t%s\n' "$dir" "$name"
                    fi
                    name=
                    dir=
                    ;;
	    esac
	done | awk -F '\t' '!seen[$1]++ { print $2 }' | sort -u
}

vendor_git_log_from_metadata()
{
    key="$1"
    value="$2"
    # Git's fixed-string grep finds candidates, but it also matches prefixes
    # such as "foo" in "foobar". Check the complete metadata line and return
    # the newest exact match. No match produces empty output for callers.
    git log --fixed-strings --grep="$key: $value" --format='%H' HEAD |
        while read -r commit; do
            if git show -s --format=%B "$commit" | grep -F -x -e "$key: $value" >/dev/null; then
                git show -s --format='START %H%n%s%n%n%b%nEND%n' "$commit"
                break
            fi
        done
}

vendor_git_log_from_name()
{
    vendor_git_log_from_metadata git-vendor-name "$1"
}

vendor_name_from_dir()
{
    name=
    vendor_git_log_from_metadata git-vendor-dir "$1" |
        while read -r a b junk; do
            case "$a" in
                git-vendor-name:) name="$b" ;;
                END)
                    if [ -n "$name" ]; then
                        echo "$name"
                    fi
                    name=
                    ;;
            esac
        done
}

cmd_add()
{
    require_clean_work_tree
    name="$1"
    repository="$2"
    ref="master"
    if [ "$3" != "" ]; then
        ref="$3"
    fi
    if [ $# -lt 2 ];
    then
        die "Incorrect options provided: git vendor add <name> <repository> [<ref>]"
    fi
    # The log readers split metadata on whitespace, and backslashes do not
    # round-trip reliably through git-subtree's commit message handling.
    case "$name" in
        ""|*[[:space:]]*|*'\'*) die "Dependency name must not be empty or contain whitespace or backslashes" ;;
    esac
    # Check only active names; a name can be reused after its tree is removed.
    if vendor_names_from_log | grep -F -x -e "$name" >/dev/null; then
        die "Dependency \"$name\" already exists"
    fi

    dir="$prefix/$(echo "$repository" | sed -E 's/^[a-zA-Z]+((:\/\/)|@)//' | sed 's/:/\//' | sed -E 's/\.git$//')"
    message="\
Add \"$name\" from \"$repository@$ref\"

git-vendor-name: $name
git-vendor-dir: $dir
git-vendor-repository: $repository
git-vendor-ref: $ref
"
    set -x
    git subtree add --prefix "$dir" --message "$message" "$repository" "$ref" --squash
}

cmd_list()
{
    showOnly="$1"
    for name in $(vendor_names_from_log);
    do
        vendor_git_log_from_name "$name" |
	    while read -r a b junk; do
	        case "$a" in
		    START) commit="$b" ;;
                    git-vendor-name:) name="$b" ;;
                    git-vendor-dir:) dir="$b" ;;
                    git-vendor-ref:) ref="$b" ;;
		    git-vendor-repository:) repository="$b" ;;
		    END)
                        if [ ! -z "$repository" ];
                        then
                            if [ -z "$showOnly" -o "$showOnly" = "$name" ]; then
                                # Metadata is data, never a printf format.
                                printf '%s@%s:\n' "$name" "$ref"
                                printf '\tname:\t%s\n' "$name"
                                printf '\tdir:\t%s\n' "$dir"
                                printf '\trepo:\t%s\n' "$repository"
                                printf '\tref:\t%s\n' "$ref"
                                printf '\tcommit:\t%s\n\n' "$commit"
                            fi
                        fi
                        name=
                        dir=
                        ref=
                        commit=
                        repository=
                        ;;
	        esac
	    done
    done;

}

cmd_update()
{
    require_clean_work_tree
    name="$1"
    ref="master"
    if [ "$2" != "" ]; then
        ref="$2"
    fi
    if [ $# -lt 1 ]; then
        die "Incorrect options provided: git vendor update <name> [<ref>]"
    fi
    log=$(vendor_git_log_from_name "$name")
    if [ -z "$log" ]; then
        die "Unknown dependency \"$name\""
    fi
    # Git log exits successfully even without a match, hence the check above.
    # This reader is the last pipeline command: exit propagates a Git failure,
    # while break would make the pipeline report success.
    printf '%s\n' "$log" |
	while read -r a b junk; do
	    case "$a" in
		START) ;;
                git-vendor-dir:) dir="$b" ;;
		git-vendor-repository:) repository="$b" ;;
		git-vendor-ref:) curr_ref="$b" ;;
		END)
                    # Make sure the dependency exists on disk
                    if [ ! -d "$dir" ]; then
                        die "Dependency \"$1\" is missing from \"$dir\""
                    fi

                    # And hasn't been renamed
                    logname=$(vendor_name_from_dir "$dir")
                    if [ "$name" != "$logname" ]; then
                        die "Dependency \"$1\" was renamed \"$logname\""
                    fi

                    if [ ! -z "$repository" ];
                    then
                        message="\
Update \"$name\" from \"$repository@$ref\"

git-vendor-name: $name
git-vendor-dir: $dir
git-vendor-repository: $repository
git-vendor-ref: $ref
"
                        git fetch "$repository" "$curr_ref" || exit $?
                        git subtree pull --prefix "$dir" --message "$message" "$repository" "$ref" --squash || exit $?
                        break
                    else
                        die "Dependency \"$name\" has no repository"
                    fi
                    ;;
	    esac
	done
}

cmd_upstream()
{
    require_clean_work_tree
    # POSIX sh has no portable local variables; clear optional arguments here.
    name=
    ref=
    repository_arg=
    while [ $# -gt 0 ] ; do
        case $1 in
            --repo)
            if [ $# -lt 2 ]; then
                die "Missing repository after --repo"
            fi
            repository_arg="$2"
            shift # argument value
            ;;
            *)
            if [ -z "$name" ]; then
                name="$1"
            elif [ -z "$ref" ]; then
                ref="$1"
            fi
            ;;
        esac
        shift # current argument
    done
    if [ -z "$name" ]; then
        die "Incorrect options provided: git vendor upstream <name> [<ref>] [--repo <repository>]"
    fi
    if [ -z "$ref" ]; then
        ref="master"
    fi
    log=$(vendor_git_log_from_name "$name")
    if [ -z "$log" ]; then
        die "Unknown dependency \"$name\""
    fi
    printf '%s\n' "$log" |
    while read -r a b junk; do
        case "$a" in
        START) ;;
        git-vendor-dir:) dir="$b" ;;
        git-vendor-repository:) repository="$b" ;;
        END)
            # Make sure the dependency exists on disk
            if [ ! -d "$dir" ]; then
                die "Dependency \"$1\" is missing from \"$dir\""
            fi

            # And hasn't been renamed
            logname=$(vendor_name_from_dir "$dir")
            if [ "$name" != "$logname" ]; then
                die "Dependency \"$1\" was renamed \"$logname\""
            fi

            if [ ! -z "$repository_arg" ];
            then
                # override the repository read from the commit logs
                # with the one read from the command line arguments
                repository="$repository_arg"
            fi
            
            if [ ! -z "$repository" ];
            then
                # Exit the pipeline reader on failure before break masks it.
                git subtree push --prefix "$dir" "$repository" "$ref" || exit $?
                break
            else
                die "Dependency \"$name\" has no repository"
            fi
            ;;
        esac
    done
}

cmd_remove()
{
    require_clean_work_tree
    name="$1"
    if [ $# -lt 1 ]; then
        die "Incorrect options provided: git vendor remove <name>"
    fi
    log=$(vendor_git_log_from_name "$name")
    if [ -z "$log" ]; then
        die "Unknown dependency \"$name\""
    fi
    printf '%s\n' "$log" |
	while read -r a b junk; do
	    case "$a" in
		START) ;;
                git-vendor-dir:) dir="$b" ;;
		END)
                    # Make sure the dependency exists
                    if [ ! -d "$dir" ]; then
                        die "Dependency \"$1\" is missing from \"$dir\""
                    fi
                    # And hasn't been renamed
                    logname=$(vendor_name_from_dir "$dir")
                    if [ "$name" != "$logname" ]; then
                        die "Dependency \"$1\" was renamed \"$logname\""
                    fi

                    # Report either failure; a rejected commit can leave the
                    # removed files staged for the caller to resolve.
                    git rm -rf "$dir" || exit $?
                    git commit --message "Removing \"$name\" from \"$dir\"" || exit $?
                    break
                    ;;
	    esac
	done
}

# Run the command
"cmd_$command" "$@"
